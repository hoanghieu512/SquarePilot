# OpenRouter — LLM provider (OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-...

# Model tiers. Free tier drafts; paid tier only on second gate failure.
OPENROUTER_MODEL_FREE=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL_PAID=anthropic/claude-sonnet-5

# Zalo approval bot (Phase 6). ZALO_CHAT_ID comes from `npm run zalo:setup`.
# ZALO_BOT_TOKEN=
# ZALO_CHAT_ID=
# ZALO_API_BASE=https://bot-api.zaloplatforms.com

# Binance Square OpenAPI (Phase 6).
# Prefer ~/.config/binance-square/openapi-key over this variable.
# BINANCE_SQUARE_OPENAPI_KEY=

# Paths to external assets — never copied into this repo
CONTENT_CREATOR_DIR=/Users/lavopavden/Dev/projects/Content-Creator
VAULT_DIR=/Users/lavopavden/Dev/vault/projects/content-creator

# Optional overrides
# SQUAREPILOT_DB_PATH=
LOG_LEVEL=info
